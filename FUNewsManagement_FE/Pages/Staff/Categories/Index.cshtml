@page
@model FUNewsManagement_FE.Pages.Staff.Categories.IndexModel
@{
    ViewData["Title"] = "Quản lý danh mục";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2>Quản lý danh mục</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Tìm theo tên danh mục..." value="@Model.Search" />
        <button class="btn btn-outline-primary" type="submit">Tìm</button>
    </div>
</form>

<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#createModal">Thêm danh mục</button>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tên danh mục</th>
            <th>Trạng thái</th>
            <th>Hành động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Categories)
        {
            <tr>
                <td>@item.Name</td>
                <td>@(item.Status == 1 ? "Active" : "Inactive")</td>
                <td>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="loadEdit('@item.Id')">Sửa</button>
                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('@item.Id')">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Tạo -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- TODO: Form tạo danh mục -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa danh mục</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- TODO: Form sửa danh mục bằng AJAX -->
            </div>
        </div>
    </div>
</div>

