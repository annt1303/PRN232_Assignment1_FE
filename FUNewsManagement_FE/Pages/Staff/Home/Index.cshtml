@page
@model FUNewsManagement_FE.Pages.Staff.Home.IndexModel
@{	
    Layout = "_Layout";
    ViewData["Title"] = "Staff Dashboard";
}

<style>
    /* Sidebar styles */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        height: 100vh;
        width: 250px;
        background: linear-gradient(135deg, #2c3e50, #3498db);
        color: #fff;
        padding-top: 20px;
        transition: all 0.3s ease;
        z-index: 1000;
    }

    .sidebar .nav-link {
        color: #fff;
        padding: 15px 20px;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
        transition: background 0.3s ease, color 0.3s ease;
    }

    .sidebar .nav-link i {
        margin-right: 10px;
    }

    .sidebar .nav-link:hover,
    .sidebar .nav-link.active {
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
        border-left: 4px solid #e74c3c;
    }

    /* Main content */
    .main-content {
        margin-left: 250px;
        padding: 30px;
        min-height: 100vh;
        background: #f4f6f9;
        transition: margin-left 0.3s ease;
    }

    .dashboard-title {
        font-weight: 700;
        font-size: 2.5rem;
        color: #2c3e50;
        text-align: center;
        margin-bottom: 30px;
        text-transform: uppercase;
        position: relative;
    }

    .dashboard-title::after {
        content: '';
        position: absolute;
        bottom: -10px;
        left: 50%;
        transform: translateX(-50%);
        width: 50px;
        height: 4px;
        background: #3498db;
        border-radius: 2px;
    }

    .card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .card:hover {
        transform: translateY(-10px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.15);
    }

    .card-header {
        background: none;
        font-weight: 600;
        color: #2c3e50;
        text-align: center;
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .card-body h3 {
        font-size: 2.5rem;
        color: #fff;
        text-align: center;
        margin: 0;
    }
 
</style>

<div class="sidebar">
    <nav class="nav flex-column">
        <a class="nav-link active" asp-page="/Staff/Profile/Index">
            <i class="bi bi-house-fill"></i> Dashboard
        </a>
        <a class="nav-link" asp-page="/Staff/News/Index">
            <i class="bi bi-newspaper"></i> Manage News
        </a>
        <a class="nav-link" asp-page="/Staff/Categories/Index">
            <i class="bi bi-list-ul"></i> Manage Categories
        </a>
        <a class="nav-link" asp-page="/Staff/Profile/Index">
            <i class="bi bi-people"></i> Profiles
        </a>
        <a class="nav-link" asp-page="/Staff/History/Index">
            <i class="bi bi-box-arrow-left"></i> Article History
        </a>
    </nav>
</div>

<div class="main-content">
    <h2 class="dashboard-title">Dashboard Overview</h2>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card bg-warning text-white">
                <div class="card-header">Total Categories</div>
                <div class="card-body">
                    <h3>TotalCategories</h3>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card bg-success text-white">
                <div class="card-header">Total News Articles</div>
                <div class="card-body">
                    <h3>TotalNewsArticles</h3>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
}
}
