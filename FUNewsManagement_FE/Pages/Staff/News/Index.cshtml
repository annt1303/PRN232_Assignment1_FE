@page
@model FUNewsManagement_FE.Pages.Staff.News.IndexModel
@{
    ViewData["Title"] = "Quản lý bài viết";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2>Quản lý bài viết</h2>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" class="form-control" placeholder="Tìm theo tiêu đề..." value="@Model.Search" />
        <button class="btn btn-outline-primary" type="submit">Tìm</button>
    </div>
</form>

<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#createModal">Thêm bài viết</button>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Tiêu đề</th>
            <th>Ngày tạo</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.NewsList)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.CreatedDate.ToString("dd/MM/yyyy")</td>
                <td>@(item.Status == 1 ? "Active" : "Inactive")</td>
                <td>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="loadEdit('@item.Id')">Sửa</button>
                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('@item.Id')">Xóa</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Tạo -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Thêm bài viết mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- TODO: Form thêm bài viết (Title, Content, Category, Tags[]) -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Sửa -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Chỉnh sửa bài viết</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- TODO: Form chỉnh sửa bài viết -->
            </div>
        </div>
    </div>
</div>

