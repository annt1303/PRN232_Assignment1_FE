@page
@model FUNewsManagement_FE.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = "News Report";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2>News Statistics Report</h2>

<form method="get" class="row mb-4">
    <div class="col-md-3">
        <label for="start">From date:</label>
        <input type="date" id="start" name="StartDate" class="form-control" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3">
        <label for="end">To date:</label>
        <input type="date" id="end" name="EndDate" class="form-control" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">View Report</button>
    </div>
</form>

@if (Model.Stats?.Any() == true)
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Headline</th>
                <th>Created Date</th>
                <th>Content</th>
                <th>Source</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Stats)
            {
                <tr>
                    <td>@item.NewsArticleId</td>
                    <td>@item.NewsTitle</td>
                    <td>@item.Headline</td>
                    <td>@item.CreatedDate?.ToString("dd/MM/yyyy")</td>
                    <td>@item.NewsContent</td>
                    <td>@item.NewsSource</td>
                </tr>
            }
        </tbody>
    </table>
}
else if (Model.StartDate != null && Model.EndDate != null)
{
    <p>No data available for the selected date range.</p>
}

@section Scripts {
    <script>
        // Optional JS section for future enhancements
    </script>
}
