@page
@model FUNewsManagement_FE.Pages.Admin.Accounts.IndexModel
@{
    ViewData["Title"] = "Account Management";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h2>Account Management</h2>

<button class="btn btn-success mb-3" data-bs-toggle="modal" data-bs-target="#createModal">Add Account</button>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>ID</th>
            <th>Email</th>
            <th>Full Name</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var acc in Model.Accounts)
        {
            <tr>
                <td>@acc.AccountId</td>
                <td>@acc.AccountEmail</td>
                <td>@acc.AccountName</td>
                <td>@(acc.AccountRole == 1 ? "Staff" : acc.AccountRole == 2 ? "Lecturer" : "Unknown")</td>
                <td>
                    <button class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#editModal" onclick="loadEdit('@acc.AccountId')">Edit</button>
                    <button class="btn btn-sm btn-danger" onclick="confirmDelete('@acc.AccountId')">Delete</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal Create (popup) -->
<div class="modal fade" id="createModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Create Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="createForm">
                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" class="form-control" id="createEmail" required />
                    </div>
                    <div class="mb-3">
                        <label>Full Name</label>
                        <input type="text" class="form-control" id="createName" required />
                    </div>
                    <div class="mb-3">
                        <label>Password</label>
                        <input type="password" class="form-control" id="createPassword" required />
                    </div>
                    <div class="mb-3">
                        <label>Role</label>
                        <select class="form-control" id="createRole">
                            <option value="1">Staff</option>
                            <option value="2">Lecturer</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Create</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal Edit (popup) -->
<div class="modal fade" id="editModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Edit Account</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId" />
                    <div class="mb-3">
                        <label>ID</label>
                        <input type="text" class="form-control" id="editAccountId" readonly />
                    </div>
                    <div class="mb-3">
                        <label>Email</label>
                        <input type="email" class="form-control" id="editEmail" readonly />
                    </div>
                    <div class="mb-3">
                        <label>Full Name</label>
                        <input type="text" class="form-control" id="editName" />
                    </div>
                    <div class="mb-3">
                        <label>Password</label>
                        <input type="text" class="form-control" id="editPassword" />
                    </div>
                    <div class="mb-3">
                        <label>Role</label>
                        <select class="form-control" id="editRole">
                            <option value="1">Staff</option>
                            <option value="2">Lecturer</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Toast Notification -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="toastMessage" class="toast align-items-center text-white bg-success border-0" role="alert">
        <div class="d-flex">
            <div class="toast-body" id="toastBody">Action completed</div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const baseUrl = "http://localhost:5115/api/SystemAccount";
        const toastEl = document.getElementById("toastMessage");
        const toastBody = document.getElementById("toastBody");
        const toast = new bootstrap.Toast(toastEl);

        function showToast(message, isSuccess = true) {
            toastBody.textContent = message;
            toastEl.classList.remove("bg-success", "bg-danger");
            toastEl.classList.add(isSuccess ? "bg-success" : "bg-danger");
            toast.show();
        }

        document.getElementById("createForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const data = {
                accountEmail: document.getElementById("createEmail").value,
                accountPassword: document.getElementById("createPassword").value,
                accountRole: parseInt(document.getElementById("createRole").value),
                accountName: document.getElementById("createName").value
            };

            const response = await fetch(baseUrl, {
                method: "POST",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                showToast("Account created successfully", true);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast("Failed to create account", false);
            }
        });

        function loadEdit(id) {
            fetch(`${baseUrl}/${id}`)
                .then(res => res.json())
                .then(data => {
                    document.getElementById("editId").value = id;
                    document.getElementById("editAccountId").value = data.accountId;
                    document.getElementById("editEmail").value = data.accountEmail;
                    document.getElementById("editName").value = data.accountName ?? "";
                    document.getElementById("editPassword").value = data.accountPassword ?? "";
                    document.getElementById("editRole").value = data.accountRole;
                });
        }

        document.getElementById("editForm").addEventListener("submit", async function (e) {
            e.preventDefault();
            const data = {
                accountId: parseInt(document.getElementById("editAccountId").value),
                accountEmail: document.getElementById("editEmail").value,
                accountRole: parseInt(document.getElementById("editRole").value),
                accountName: document.getElementById("editName").value,
                accountPassword: document.getElementById("editPassword").value
            };

            const response = await fetch(baseUrl, {
                method: "PUT",
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            if (response.ok) {
                showToast("Account updated successfully", true);
                setTimeout(() => location.reload(), 1500);
            } else {
                showToast("Failed to update account", false);
            }
        });

        function confirmDelete(id) {
            if (confirm("Are you sure you want to delete this account?")) {
                fetch(`${baseUrl}/${id}`, {
                    method: "DELETE"
                })
                    .then(res => {
                        if (res.ok) {
                            showToast("Account deleted successfully", true);
                            setTimeout(() => location.reload(), 1500);
                        } else {
                            showToast("Failed to delete account", false);
                        }
                    });
            }
        }
    </script>
}
