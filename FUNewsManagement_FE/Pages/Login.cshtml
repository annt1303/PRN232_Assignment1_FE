@page
@model FUNewsManagement_FE.Pages.LoginModel
@{
    Layout = "_Layout";
}

<style>
    body, html {
        margin: 0;
        padding: 0;
        background: linear-gradient(to right, #74ebd5, #acb6e5);
        background-size: cover;
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
    }

    .login-container {
        background-color: #ffffff;
        padding: 2.5rem;
        border-radius: 15px;
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
        width: 100%;
        max-width: 420px;
        transition: transform 0.3s ease;
    }

        .login-container:hover {
            transform: translateY(-2px);
        }

    .login-header {
        color: #2c3e50;
        text-align: center;
        margin-bottom: 1.8rem;
        font-size: 1.8rem;
        font-weight: 600;
    }

    .form-label {
        color: #1a535c;
        font-weight: 600;
    }

    .form-control {
        border: 1px solid #d1dce8;
        border-radius: 8px;
        background-color: #f8f9fa;
        padding: 0.75rem;
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 6px rgba(52, 152, 219, 0.4);
            background-color: #fff;
        }

    .btn-primary {
        background-color: #3498db;
        border-color: #3498db;
        font-weight: 600;
        padding: 0.75rem;
        border-radius: 8px;
        transition: all 0.3s ease;
    }

        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }

    .text-danger {
        font-size: 0.875rem;
        margin-top: 0.25rem;
    }

    .forgot-password {
        text-align: right;
        margin-top: 0.5rem;
    }

        .forgot-password a {
            color: #1abc9c;
            text-decoration: none;
            font-weight: 500;
        }

            .forgot-password a:hover {
                color: #16a085;
                text-decoration: underline;
            }

    .error-alert {
        font-size: 0.9rem;
        margin-bottom: 1rem;
    }
</style>

<div class="login-wrapper">
    <div class="login-container">
        <h2 class="login-header">Đăng nhập hệ thống</h2>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger error-alert" role="alert">
                @foreach (var modelError in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@modelError.ErrorMessage</div>
                }
            </div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" type="password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="forgot-password">
                <a href="#">Quên mật khẩu?</a>
            </div>

            <button type="submit" class="btn btn-primary w-100 mt-3">Đăng nhập</button>
        </form>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
